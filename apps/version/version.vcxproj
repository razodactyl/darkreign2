<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Build host tool: rewrites version.rc for appdr2 / appmesh as a PreLink step.
    Deliberately kept out of dr2.sln - appdr2's PreLink event runs ..\tools\version,
    so relinking the tool as part of a parallel solution build would race with the
    projects that invoke it. Rebuild it on its own when version.cpp changes:

      msbuild apps\version\version.vcxproj -p:Configuration=Release -p:Platform=Win32

    The output lands straight in tools\, which is where the PreLink events look.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7D1A4E93-6C22-4F0B-9A45-2C8E1B0A7F31}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseOfMfc>false</UseOfMfc>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- Resolved from the project, not $(SolutionDir), so it builds standalone. -->
    <RepoRoot>$(MSBuildProjectDirectory)\..\..\</RepoRoot>
    <OutDir>$(RepoRoot)tools\</OutDir>
    <IntDir>$(RepoRoot)bin\$(Configuration)\version\</IntDir>
    <TargetName>version</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <!-- Must match system.lib: /MT, /Gr, WIN32;NDEBUG. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <CallingConvention>FastCall</CallingConvention>
      <Optimization>MaxSpeed</Optimization>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>WIN32;NDEBUG;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>../../3rdparty;../../system;../../util;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ForcedIncludeFiles>std.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <AdditionalDependencies>system.lib;util.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(RepoRoot)bin\$(Configuration)\</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="version.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
